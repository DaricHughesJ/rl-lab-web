{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rl-lab-web",
  "main": "./src/worker.js",
  "compatibility_date": "2026-08-12",
  "vars": {
    "SUPABASE_URL": "https://pdqkrhzjjtixkxgcwzif.supabase.co"
  },
  "r2_buckets": [
    {
      "binding": "BETA_DOWNLOADS",
      "bucket_name": "mechlab-private-beta"
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  }
}
