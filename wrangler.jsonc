{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rl-lab-web",
  "main": "./src/worker.js",
  "compatibility_date": "2026-08-12",
  "workers_dev": false,
  "preview_urls": false,
  "placement": { "mode": "smart" },
  "routes": [
    { "pattern": "mechlab.gg", "custom_domain": true },
    { "pattern": "www.mechlab.gg", "custom_domain": true }
  ],
  "vars": {
    "SUPABASE_URL": "https://pdqkrhzjjtixkxgcwzif.supabase.co"
  },
  "r2_buckets": [
    {
      "binding": "BETA_DOWNLOADS",
      "bucket_name": "mechlab-private-beta"
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  },
  "previews": {
    "placement": { "mode": "smart" },
    "vars": {
      "SUPABASE_URL": "https://pdqkrhzjjtixkxgcwzif.supabase.co"
    },
    "r2_buckets": [
      {
        "binding": "BETA_DOWNLOADS",
        "bucket_name": "mechlab-web-preview"
      }
    ]
  }
}
